package com.prasad.fixture.url_shortener.analytics;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.stereotype.Component;
import org.springframework.web.servlet.HandlerInterceptor;

import java.util.regex.Pattern;

@Component
public class RedirectAnalyticsInterceptor
        implements HandlerInterceptor {

    private static final Pattern REDIRECT_PATH =
            Pattern.compile(
                    "^/[A-Za-z0-9]{8}$"
            );

    private final RedirectAnalyticsService service;

    public RedirectAnalyticsInterceptor(
            RedirectAnalyticsService service
    ) {
        this.service = service;
    }

    @Override
    public void afterCompletion(
            HttpServletRequest request,
            HttpServletResponse response,
            Object handler,
            Exception exception
    ) {
        if (exception != null ||
                !"GET".equalsIgnoreCase(
                        request.getMethod()
                )) {
            return;
        }

        int status = response.getStatus();

        if (status < 300 || status >= 400) {
            return;
        }

        String path = request.getRequestURI();

        if (!REDIRECT_PATH.matcher(path).matches()) {
            return;
        }

        service.recordRedirect(
                path.substring(1)
        );
    }
}